# 本地部署配置；首次使用时复制为 .env，手动填写下方密码、密钥和 OSS 配置。
# 站点品牌名称，供用户前台和管理后台使用；修改后需重新构建前端。
APP_BRAND_NAME=测试
# 用户前台的本机访问端口，默认 8081。
WEB_PORT=8081
# 管理后台的本机访问端口，默认 8082。
ADMIN_PORT=8082
# 后端接口的本机访问端口，默认 8080。
API_PORT=8080
# 可选的 Nginx 运行镜像；留空时部署脚本优先复用本地已有的 Nginx/前端镜像。
# NGINX_IMAGE=nginx:1.28-alpine
# 后台管理员初始账号，长度 2–20 个字符，不含首尾空格；仅首次初始化时应用。
HONGSHU_ADMIN_USERNAME=admin
# 后台管理员初始密码，长度 5–20 个字符；后续修改此项不会覆盖数据库中的密码。
HONGSHU_ADMIN_PASSWORD=
# MySQL 超级管理员 root 的密码，用于数据库初始化和管理。
MYSQL_ROOT_PASSWORD=
# 应用数据库账号 hongshu 的密码，后端使用该账号连接 MySQL。
DB_PASSWORD=
# Redis 连接密码，供后端连接以及 Redis 身份认证使用。
REDIS_PASSWORD=
# 用户前台登录令牌的 JWT 签名密钥，请使用随机字符串并保密。
HONGSHU_JWT_APP_SECRET=
# 管理后台登录令牌的签名密钥，应与前台 JWT 密钥分别设置。
TOKEN_SECRET=
# 阿里云 OSS 上传和删除使用的 HTTPS 访问端点，需与存储桶所在地域匹配。
OSS_ENDPOINT=
# 阿里云 OSS 存储桶所在地域，例如 cn-shanghai 表示华东 2（上海）。
OSS_REGION=
# 阿里云 OSS 存储桶名称，填写自己已创建的存储桶，不包含协议或域名。
OSS_BUCKET=
# 用于访问 OSS 的 RAM 用户 AccessKey ID，仅供后端使用，不要使用 VITE_ 前缀。
OSS_ACCESS_KEY_ID=
# 上述 AccessKey 对应的 Secret，仅供后端使用，请保密，不要提交到代码仓库。
OSS_ACCESS_KEY_SECRET=
# 可选的图片公网访问 HTTPS 域名，不包含路径或参数；留空时使用存储桶默认公网域名。
OSS_PUBLIC_URL=
