# 本机编译配置与服务器运行配置；首次使用时复制为 .env 并填写密钥。
# 品牌名在本机编译进前端，修改后需要重新构建、发布镜像。
APP_BRAND_NAME=测试
# 本机默认镜像前缀；发布时改成 registry.cn-shanghai.aliyuncs.com/命名空间/hongshu。
# 对应四个仓库：hongshu-backend、hongshu-web、hongshu-admin、hongshu-mysql。
IMAGE_PREFIX=hongshu
IMAGE_TAG=local
# Redis 使用官方镜像，也可填写服务器可访问的镜像仓库地址。
REDIS_IMAGE=redis:7.4-alpine
# 服务器对外监听地址；deploy/local.ps1 会自动改成 127.0.0.1。
BIND_ADDRESS=0.0.0.0
WEB_PORT=80
ADMIN_PORT=8082
# 仅本机 compose.local.yaml 发布后端端口；服务器不直接暴露后端、MySQL、Redis。
API_PORT=8080
BACKEND_MEMORY_LIMIT=2g
# 可选 JVM 参数；通常使用 Compose 内置的容器内存比例即可。
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -XX:InitialRAMPercentage=25.0 -XX:+ExitOnOutOfMemoryError
# 管理员账号 2–20 字符、密码 5–20 字符，仅首次初始化时应用。
HONGSHU_ADMIN_USERNAME=admin
HONGSHU_ADMIN_PASSWORD=
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
HONGSHU_JWT_APP_SECRET=
TOKEN_SECRET=
# OSS 密钥仅在运行时传给后端，不会写入镜像和服务器配置包。
OSS_ENDPOINT=
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选的图片公网 HTTPS 域名，不包含路径或参数。
OSS_PUBLIC_URL=
