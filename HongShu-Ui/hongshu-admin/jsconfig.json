{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["vite/client", "element-plus/global"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/**/*.vue", "src/**/*.d.ts", "vite/**/*.js", "vite.config.js"],
  "exclude": ["node_modules", "dist"]
}
